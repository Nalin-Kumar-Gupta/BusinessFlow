{
  "name": "testtrace",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first, local-only Chrome MV3 extension for manual QA evidence recording.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:backend": "tsc --project backend/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixture": "node fixture/server.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "verify": "pnpm typecheck && pnpm typecheck:backend && pnpm lint && pnpm test && pnpm build",
    "billing:setup-notification-destination": "node backend/scripts/setup-paddle-notification-destination.mjs"
  },
  "dependencies": {
    "@paddle/paddle-js": "^1.6.5",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@react-pdf/renderer": "^4.9.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.0",
    "jszip": "^3.10.1",
    "preact": "^10.24.3",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/chrome": "^0.0.278",
    "@types/node": "^22.7.5",
    "@types/react": "^19.2.18",
    "esbuild": "^0.24.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vitest": "^2.1.2"
  },
  "packageManager": "pnpm@9.15.9"
}
